# Neon / PostgreSQL connection string — set it in Vercel → Project → Settings → Environment Variables.
# Never commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Optional, first login of the system admin only (min 12 characters).
# Works only while that admin account has no password issued by the new system.
# ADMIN_BOOTSTRAP_EMAIL=mahmoud@tieapps.com
# ADMIN_BOOTSTRAP_PASSWORD=choose-a-long-random-password
